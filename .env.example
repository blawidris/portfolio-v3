# Neon PostgreSQL — pooled connection (used at runtime)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/portfolio?sslmode=require"

# Neon PostgreSQL — direct connection (used by Prisma migrate/push, remove -pooler from hostname)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/portfolio?sslmode=require"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Canonical public origin (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bootstrap admin account — read only by `npm run db:seed` to create the
# first Admin row (bcrypt-hashed). NOT consulted at runtime login anymore;
# rotate the password afterward via /admin/settings.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Resend — optional, required for the "forgot password" email to actually
# send. Without it, the app still works; the reset-password flow just can't
# deliver its email until these are set.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Cloudflare R2 — optional, required for media uploads in /admin/media.
# Without it, the app still works; uploads return a clear "not configured" error.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""
