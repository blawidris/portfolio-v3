# Neon PostgreSQL — pooled connection (used at runtime)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/portfolio?sslmode=require"

# Neon PostgreSQL — direct connection (used by Prisma migrate/push, remove -pooler from hostname)
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/portfolio?sslmode=require"

# NextAuth — generate with: npx auth secret
AUTH_SECRET=""

# Admin credentials for /admin login
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
