generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String   @db.Text
  tags        String[] @default([])
  readingTime String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  content      String   @db.Text
  type         String
  category     String   @default("side-project") // "work" | "side-project"
  status       String
  year         Int
  stack        String[] @default([])
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Defaults to true (not false, unlike Post.published) so the migration
  // that adds this column never hides the 7 already-public real projects.
  published    Boolean            @default(true)
  previewToken String?            @unique
  coverMediaId String?
  coverMedia   Media?             @relation("ProjectCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  images       ProjectImage[]
  challenges   ProjectChallenge[]
  metrics      ProjectMetric[]
  caseStudies  CaseStudy[]
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  role      String   @default("gallery") // "gallery" | "diagram"
  caption   String?
  order     Int      @default(0)

  @@index([projectId])
}

model ProjectChallenge {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  order       Int      @default(0)

  @@index([projectId])
}

model ProjectMetric {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  value     String
  context   String?
  order     Int      @default(0)

  @@index([projectId])
}

model CaseStudy {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  slug         String    @unique
  summary      String
  content      String    @db.Text
  coverMediaId String?
  coverMedia   Media?    @relation("CaseStudyCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  published    Boolean   @default(true)
  previewToken String?   @unique
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
}

model FooterLink {
  id        String   @id @default(cuid())
  label     String
  url       String
  icon      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Admin {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  resetTokens         PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

model Media {
  id              String   @id @default(cuid())
  filename        String
  mimeType        String
  size            Int
  storageKey      String   @unique
  storageProvider String   @default("r2")
  width           Int?
  height          Int?
  altText         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  certifications  Certification[]
  resumes         Resume[]
  projectCovers   Project[]      @relation("ProjectCover")
  projectImages   ProjectImage[]
  caseStudyCovers CaseStudy[]    @relation("CaseStudyCover")
}

model Profile {
  id           String   @id @default("profile")
  name         String
  headline     String
  tagline      String
  bio          String   @db.Text
  philosophy   String[] @default([])
  location     String
  availability String
  updatedAt    DateTime @updatedAt
}

model Experience {
  id           String   @id @default(cuid())
  role         String
  company      String
  period       String
  description  String   @db.Text
  technologies String[] @default([])
  isCurrent    Boolean  @default(false)
  visible      Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SkillCategory {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  order   Int     @default(0)
  visible Boolean @default(true)
  skills  Skill[]
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  icon       String?
  featured   Boolean       @default(false)
  visible    Boolean       @default(true)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId])
}

model Certification {
  id            String    @id @default(cuid())
  name          String
  issuer        String
  issueDate     DateTime
  credentialUrl String?
  badgeMediaId  String?
  badgeMedia    Media?    @relation(fields: [badgeMediaId], references: [id], onDelete: SetNull)
  visible       Boolean   @default(true)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Resume {
  id             String   @id @default(cuid())
  mediaId        String
  media          Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  publicFilename String
  isActive       Boolean  @default(false)
  publicDownload Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
